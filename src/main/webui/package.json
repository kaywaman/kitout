{
  "name": "kitout-ui",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.1.0",
  "type": "module",
  "description": "Web UI of kitout. Built into the daemon by Quinoa; see docs/MAINTAINING.md.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "generate:api": "node scripts/generate-api.mjs",
    "dev": "node scripts/generate-api.mjs --optional && vite",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "build": "npm run generate:api && tsc --noEmit && vite build"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "vite": "^8.1.0"
  }
}
